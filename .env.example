# Copy this file to .env and edit it. Never commit .env.
# Local development defaults.
APP_ENV=local
APP_URL=http://localhost/krono/public
APP_KEY=change-this-to-a-long-random-text
# Workspace timezone default (all dates are stored in UTC; shown in this zone)
APP_TIMEZONE=Asia/Dhaka
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=krono
DB_USER=root
DB_PASS=
# fixed = code 123456 (APP_ENV=local only) | log = random code written to storage/logs/mail.log | smtp = real email (later)
MAIL_MODE=fixed
FIXED_CODE=123456
